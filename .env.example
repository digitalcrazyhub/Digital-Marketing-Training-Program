# ==============================================================================
# DIGITAL CRAZY HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Application Environment (production / development)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://training.digitalcrazyhub.com

# Workshop Details
WORKSHOP_TITLE="₹49 AI-Integrated Digital Marketing Paid Workshop"
WORKSHOP_DATE="November 24, 2026"
WORKSHOP_DAY="Tuesday"
WORKSHOP_TIME="7:00 PM IST"
WORKSHOP_PRICE=49.00
WORKSHOP_AMOUNT_PAISE=4900
WORKSHOP_CURRENCY=INR
WORKSHOP_PLATFORM="Live on Zoom"
WORKSHOP_LANGUAGE=Tamil

# Contact & Links
COMPANY_NOTIFICATION_EMAIL=info@digitalcrazyhub.com
WHATSAPP_COMMUNITY_URL="https://chat.whatsapp.com/digitalcrazyhub-dm-workshop"

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dch_workshop
DB_USER=root
DB_PASS=

# Razorpay Payment Gateway Credentials
# Replace with live keys in production (rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=dch_test_secret_replace_in_production
RAZORPAY_WEBHOOK_SECRET=dch_webhook_secret_replace_in_production

# Google Sheets API Service Account Credentials (OAuth2 JWT)
# 1. Share your Google Sheet with this client email (Role: Editor)
# 2. Extract private_key and client_email from downloaded JSON key file
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Enrollments
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# SMTP Email Settings (Hostinger / cPanel / Gmail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=info@digitalcrazyhub.com
SMTP_PASS=
SMTP_FROM_EMAIL=info@digitalcrazyhub.com
SMTP_FROM_NAME="Digital Crazy Hub"

# Google reCAPTCHA v3 Keys
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Background Synchronization / Cron Job Secret
CRON_SECRET=dch_cron_sync_secure_key_2026

