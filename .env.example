# ==============================================================================
# DIGITAL CRAZY HUB - WORKSHOP ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your production credentials.
# ==============================================================================

# Application Environment (production / development)
APP_ENV=development
APP_URL=http://localhost/training-digitalcrazyhub

# Razorpay Credentials (from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Workshop Payment & Event Settings (Single Source of Truth)
WORKSHOP_PRICE=49
WORKSHOP_CURRENCY=INR
WORKSHOP_DATE="November 5, 2026"
WORKSHOP_DAY="Thursday"
WORKSHOP_TIME="7:00 PM IST"
WORKSHOP_LANGUAGE="Tamil"
WORKSHOP_PLATFORM="Live on Zoom"
WORKSHOP_TIMEZONE="Asia/Kolkata"

# Official WhatsApp Workshop Community Invitation Link
WHATSAPP_COMMUNITY_URL="https://chat.whatsapp.com/digitalcrazyhub-dm-workshop"

# Database Configuration (MySQL / MariaDB on Hostinger, cPanel, or XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dch_workshop
DB_USER=root
DB_PASS=

# Google Sheets Integration (Google Service Account)
# 1. Create a Project on Google Cloud Console -> Enable Google Sheets API
# 2. Create a Service Account -> Download JSON Key
# 3. Share your Google Sheet with the Service Account email (Editor permissions)
# 4. Copy the Spreadsheet ID from the Sheet URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Enrollments
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Either paste the raw RSA private key here (with \n) or place the credentials JSON in backend/config/google-service-account.json:
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_APPLICATION_CREDENTIALS=backend/config/google-service-account.json

# SMTP Email Configuration (Hostinger Webmail, Gmail, etc.)
# Hostinger SMTP: smtp.hostinger.com | Port: 465 (SSL) or 587 (TLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@digitalcrazyhub.com
SMTP_PASS=
SMTP_SECURE=ssl
SMTP_FROM_EMAIL=info@digitalcrazyhub.com
SMTP_FROM_NAME="Digital Crazy Hub"
COMPANY_NOTIFICATION_EMAIL=info@digitalcrazyhub.com

# Google reCAPTCHA v3 (Spam Protection)
# Get from https://www.google.com/recaptcha/admin
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
