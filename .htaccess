<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent access to sensitive dot files and directories
    RewriteRule ^(\.env|\.git|\.htaccess) - [F,L]

    # Block access to private directories if document root is repository root
    RewriteRule ^(backend|app|storage|database)/ - [F,L]

    # Rewrite all public traffic to /public/ directory if document root is repo root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

