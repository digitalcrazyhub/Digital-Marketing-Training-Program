# Digital Crazy Hub - Backend Root Access Control
Options -Indexes

# Protect sensitive files and directories
<FilesMatch "\.(env|json|log|sql|lock|md|git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Allow API routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^api/(.*)$ api/$1 [L]
</IfModule>
